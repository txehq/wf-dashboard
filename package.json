{
  "name": "wf-dashboard",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names server,web --prefix-colors blue,magenta \"pnpm --filter @wf-dashboard/server dev\" \"pnpm --filter @wf-dashboard/web dev\"",
    "build": "pnpm --recursive build",
    "start": "tsx start.ts",
    "test": "pnpm --filter @wf-dashboard/server test",
    "check": "taskpolicy -c utility tsx check.ts",
    "typecheck": "taskpolicy -c utility sh -c 'tsc --project tsconfig.json && pnpm --recursive typecheck'",
    "lint": "taskpolicy -c utility sh -c 'eslint . && prettier --check . && tsx lint-cjk.ts'",
    "format": "prettier --write .",
    "release": "tsx release/release.ts"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.4",
    "@types/proper-lockfile": "4.1.4",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "execa": "10.1.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "proper-lockfile": "4.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
