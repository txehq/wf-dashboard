{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    // e2e 中 evaluate 的回调在浏览器中运行
    "lib": ["ES2023", "DOM"],
    "noEmit": true
  },
  "include": [
    "check.ts",
    "e2e",
    "playwright.config.ts",
    "playwright.real.config.ts",
    "playwright.guide.config.ts",
    "ports.ts"
  ]
}
