#!/bin/bash
# 基础档（pnpm test、pnpm e2e）PATH 中的 npx（test/setup/basic-tier.ts 放入）：基础档不依赖网络，
# mcp-remote（Linear MCP，连接 mcp.linear.app）记下这次调用后以原文报错退出；其余 npx 调用交给 PATH 中后面的 npx。
# MCP SDK 只给 mcp-remote 传 PATH、HOME 等少数环境变量，所以 blocked.log 按本文件的位置找（与 basic-tier.ts 相同）
set -euo pipefail
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
log="$self_dir/../../../../../.work/basic-tier/blocked.log"
for arg in "$@"; do
  if [[ "$arg" == mcp-remote || "$arg" == mcp-remote@* ]]; then
    echo "$(date '+%Y-%m-%dT%H:%M:%S') pid=$PPID cwd=$PWD npx $*" >>"$log"
    echo "基础档不允许连接 Linear MCP（不依赖网络）：npx $*" >&2
    exit 1
  fi
done
rest=""
IFS=: read -ra dirs <<<"$PATH"
for dir in "${dirs[@]}"; do
  [[ "$dir" == "$self_dir" ]] || rest="${rest:+$rest:}$dir"
done
exec env PATH="$rest" npx "$@"
