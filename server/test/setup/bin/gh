#!/bin/bash
# 测试进程 PATH 中的 gh（test/setup/github-guard.ts 放入）：在 GitHub 上创建或修改对象的命令以原文报错退出，
# 其余命令原样交给真实的 gh（WFD_REAL_GH）
set -euo pipefail
: "${WFD_REAL_GH:?WFD_REAL_GH 未设置：这个 gh 只能经 test/setup/github-guard.ts 使用}"

deny() {
  echo "测试不允许在 GitHub 上创建或修改对象（$1）：gh $ORIGINAL" >&2
  exit 1
}
ARGS=("$@")
ORIGINAL="$*"

case "${1:-} ${2:-}" in
  "repo create" | "repo edit" | "repo delete" | "repo fork" | "repo rename" | "repo archive" | \
    "pr create" | "pr ready" | "pr merge" | "pr close" | "pr reopen" | "pr comment" | "pr review" | \
    "pr edit" | "issue create" | "release create" | "workflow run" | "run rerun" | "secret set" | \
    "variable set" | "label create")
    deny "$1 $2"
    ;;
esac

if [ "${1:-}" = "api" ]; then
  shift
  method=""
  endpoint=""
  has_body=false
  mutation=false
  while [ $# -gt 0 ]; do
    case "$1" in
      -X | --method)
        method="$2"
        shift 2
        continue
        ;;
      -X*) method="${1#-X}" ;;
      --method=*) method="${1#--method=}" ;;
      -f | -F | --field | --raw-field)
        has_body=true
        if [[ "$2" =~ ^query=[[:space:]]*mutation ]]; then mutation=true; fi
        shift 2
        continue
        ;;
      --input)
        has_body=true
        shift 2
        continue
        ;;
      -H | --header | -q | --jq | -t | --template | --hostname | --cache)
        shift 2
        continue
        ;;
      -*) ;;
      *) [ -z "$endpoint" ] && endpoint="$1" ;;
    esac
    shift
  done
  upper="$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')"
  case "$upper" in
    POST | PUT | PATCH | DELETE) [ "$endpoint" = "graphql" ] || deny "api -X $upper $endpoint" ;;
  esac
  # 带请求体而没有指定方法时 gh 用 POST；graphql 的查询照常放行，mutation 拦下
  if [ "$endpoint" = "graphql" ]; then
    $mutation && deny "api graphql mutation"
  elif [ -z "$upper" ] && $has_body; then
    deny "api POST $endpoint"
  fi
fi

exec "$WFD_REAL_GH" ${ARGS[@]+"${ARGS[@]}"}
