#!/usr/bin/env node
// 测试中的 gh：按参数回放 WFD_GH_REPLAY 指向的录制文件（scripts/record-gh-error-fixtures.ts 录下的真实 gh 输出）。
// 成功时输出写到 stdout，失败时写到 stderr，以录下的退出码退出；没有录下的命令以原文报错
import fs from 'node:fs';

const file = process.env.WFD_GH_REPLAY;
if (file === undefined) throw new Error('WFD_GH_REPLAY 未设置：这个 gh 只回放录下的输出');
const { commands } = JSON.parse(fs.readFileSync(file, 'utf8'));
const args = process.argv.slice(2);
const recorded = commands.find((c) => JSON.stringify(c.args) === JSON.stringify(args));
if (recorded === undefined) throw new Error(`${file} 中没有录下 gh ${args.join(' ')}`);
(recorded.exitCode === 0 ? process.stdout : process.stderr).write(`${recorded.output}\n`);
process.exitCode = recorded.exitCode;
