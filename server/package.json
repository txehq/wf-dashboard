    "drizzle-orm": "0.45.4",
    "execa": "10.1.0",
    "fastify": "5.12.5",
    "junit2json": "4.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.4",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
